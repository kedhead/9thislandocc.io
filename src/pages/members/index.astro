---
import MembersLayout from '../../layouts/MembersLayout.astro';
import ScheduleSection from '../../components/ScheduleSection.astro';

// AUTH CHECK FIRST
if (!Astro.cookies.has('members_auth')) {
  return Astro.redirect('/members/login');
}
---

<MembersLayout title="Dashboard">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12">
    <div class="mb-4 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Welcome, Ohana!</h1>
        <p class="text-gray-600">Here is the latest schedule and club updates.</p>
      </div>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/members/schedule" class="btn-lava px-6 py-3 rounded-lg font-bold flex items-center gap-2 shadow-md hover:shadow-lg transition">
          Manage Schedule
        </a>
      </div>
    </div>
  </div>

  <!-- Live club calendar, same feed the public site shows -->
  <ScheduleSection
    eyebrow="Live from ImuaTrak"
    heading="Club Calendar"
    background="var(--bg)"
    padding="24px 24px 72px"
  />
</MembersLayout>
